<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>SqlOptimizer.Desktop.Engine</RootNamespace>
    <Description>Local engine host for the SqlOptimizer desktop application: executes the existing Application/Rules/Infrastructure pipeline in-process over a stdin/stdout JSON protocol. No HTTP, no ASP.NET, no web server.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SqlOptimizer.Domain\SqlOptimizer.Domain.csproj" />
    <ProjectReference Include="..\SqlOptimizer.Application\SqlOptimizer.Application.csproj" />
    <ProjectReference Include="..\SqlOptimizer.Rules\SqlOptimizer.Rules.csproj" />
    <ProjectReference Include="..\SqlOptimizer.Infrastructure\SqlOptimizer.Infrastructure.csproj" />
  </ItemGroup>

</Project>
