<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <configSections>
    <section name="Database" type="System.Configuration.NameValueSectionHandler" />
    <section name="Llm" type="System.Configuration.NameValueSectionHandler" />
  </configSections>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>
  <appSettings>
    <!-- Optional absolute path to the engine host executable. When empty the
         application locates the engine relative to its own output folder
         (for example ..\..\..\..\SqlOptimizer.Desktop.Engine\bin\Debug\net8.0). -->
    <add key="Desktop.EnginePath" value="" />
    <!-- Default operation timeout in seconds sent to the engine (10-600). -->
    <add key="Desktop.DefaultOperationTimeoutSeconds" value="300" />
  </appSettings>
  <!--
    Database is optional. When ConnectionString is empty or Enabled is false
    the engine runs in fully static mode: validation reports NotExecuted /
    Inconclusive outcomes and never fakes a successful comparison.
    Connection strings are secrets: they are only sent to the local engine
    process and are never logged or displayed by the application.
  -->
  <Database>
    <add key="ConnectionString" value="" />
    <add key="Enabled" value="false" />
    <add key="CommandTimeoutSeconds" value="30" />
    <add key="ConnectionTimeoutSeconds" value="15" />
    <add key="MaxRowsForComparison" value="1000" />
    <add key="MaxResultCells" value="20000" />
    <add key="ApplicationName" value="SqlOptimizer.Desktop" />
    <add key="MetadataCacheTtlSeconds" value="300" />
    <add key="MetadataCacheMaxEntries" value="256" />
  </Database>
  <!--
    LLM is optional and DISABLED by default (empty Provider). Supported
    values: "OpenAI" (any OpenAI-compatible HTTP API) or "Mock".
    The API key is a secret: it is only sent to the local engine process
    and is never logged or displayed by the application.
  -->
  <Llm>
    <add key="Provider" value="" />
    <add key="Model" value="" />
    <add key="ApiKey" value="" />
    <add key="Endpoint" value="" />
    <add key="Temperature" value="0.1" />
    <add key="TimeoutSeconds" value="120" />
    <add key="MaxPromptChars" value="60000" />
    <add key="MaxCompletionTokens" value="2000" />
  </Llm>
</configuration>
